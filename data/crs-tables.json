      "highWageCanadianWorkExperience": {
        "minimumQualifyingDurationMonths": 12,
        "minimumQualifyingHours": 1560,
        "lookbackYears": 10,
        "maximum": {
          "withSpouse": 70,
          "withoutSpouse": 70
        },
        "withSpouse": {
          "noneOrNotQualified": 0,
          "level1_3x": 20,
          "level1_5x": 40,
          "level2_0x": 70
        },
        "withoutSpouse": {
          "noneOrNotQualified": 0,
          "level1_3x": 20,
          "level1_5x": 40,
          "level2_0x": 70
        },
        "rules": [
          "Occupation level is based on the official list for the NOC, not on the individual worker salary.",
          "Apply level2_0x if at least 12 qualifying months are in one or more level2_0x occupations.",
          "Otherwise apply level1_5x if at least 12 qualifying months are in eligible level1_5x or level2_0x occupations combined.",
          "Otherwise apply level1_3x if at least 12 qualifying months are in any eligible high-wage occupations combined.",
          "Concurrent periods may be considered distinctly for identifying the applicable level; hours cannot be double-counted for work-duration points."
        ]
      },
      "highWageJobOffer": {
        "minimumOfferDurationMonthsAfterPRVisa": 12,
        "minimumFullTimeHoursPerWeek": 30,
        "maximum": {
          "withSpouse": 100,
          "withoutSpouse": 100
        },
        "withSpouse": {
          "noneOrNotQualified": 0,
          "level1_3x": 50,
          "level1_5x": 70,
          "level2_0x": 100
        },
        "withoutSpouse": {
          "noneOrNotQualified": 0,
          "level1_3x": 50,
          "level1_5x": 70,
          "level2_0x": 100
        },
        "rules": [
          "A qualifying offer must be genuine, meet other current Express Entry conditions, and be in an occupation on the official high-wage occupation list.",
          "LMIA is not required solely for the job offer to qualify under the November 3, 2026 rules.",
          "Old 50/200 arranged-employment CRS points outside Labour Market Integration are not additive."
