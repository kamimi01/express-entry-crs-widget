    "labourMarketIntegration": {
      "effectiveDate": "2026-11-03",
      "scoringRule": "Take the greater of (qualifying Canadian work duration points + qualifying high-wage Canadian work experience points) OR qualifying high-wage job offer points; do not add both alternatives.",
